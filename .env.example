# Pass these at build/run time with --dart-define. Never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_REDIRECT_URL=in.komnivo.app://login-callback

# Firebase Web client config and VAPID public key are public identifiers.
# Use the same values in Cloudflare Pages Production build variables.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_VAPID_KEY=

# LiveKit URL is returned by the token function; no LiveKit secret belongs in a client.
